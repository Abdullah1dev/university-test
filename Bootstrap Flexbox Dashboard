<!DOCTYPE html>
<html>
<head>

    <title>Student Dashboard</title>

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap CSS -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>

        body {
            background-color: #f2f2f2;
        }

        .dashboard-item {
            background-color: white;
            padding: 25px;
            border-radius: 10px;
            min-width: 200px;
            flex: 1;

            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        .dashboard-item h3 {
            margin: 0;
        }

    </style>

</head>

<body>

    <div class="container py-5">

        <h1 class="text-center mb-5">
            Student Dashboard
        </h1>


        <!-- Bootstrap Flexbox -->

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

            <!-- Courses -->

            <div class="dashboard-item">

                <h3>Courses</h3>

                <p class="text-muted">
                    5 Active Courses
                </p>

                <button class="btn btn-dark">
                    View Courses
                </button>

            </div>


            <!-- Assignments -->

            <div class="dashboard-item">

                <h3>Assignments</h3>

                <p class="text-muted">
                    3 Pending Assignments
                </p>

                <button class="btn btn-dark">
                    View Assignments
                </button>

            </div>


            <!-- Projects -->

            <div class="dashboard-item">

                <h3>Projects</h3>

                <p class="text-muted">
                    4 Completed Projects
                </p>

                <button class="btn btn-dark">
                    View Projects
                </button>

            </div>


            <!-- Attendance -->

            <div class="dashboard-item">

                <h3>Attendance</h3>

                <p class="text-muted">
                    92% Attendance
                </p>

                <button class="btn btn-dark">
                    View Attendance
                </button>

            </div>

        </div>

    </div>

</body>
</html>